{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{**/__pycache__/**,**/*.pyc,**/tests.py,**/tests/**,media/**,import_uploads/**,staticfiles/**,**/*.xlsx,*.log}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
