# Django core
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=false
ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1

# Database URL (production, Neon)
# If DATABASE_URL is set, backend will use this and ignore DB_* values.
# Example:
# DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Frontend + CORS/CSRF
FRONTEND_URL=https://your-frontend-project.vercel.app
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=https://your-frontend-project.vercel.app
# Supports Vercel preview deployments. Escape backslashes as required by your shell/dashboard.
CORS_ALLOWED_ORIGIN_REGEXES=^https://[a-z0-9-]+\.vercel\.app$
CSRF_TRUSTED_ORIGINS=https://your-frontend-project.vercel.app

# Local PostgreSQL fallback (used when DATABASE_URL is empty)
DB_NAME=CRM
DB_USER=postgres
DB_PASSWORD=Zora
DB_HOST=localhost
DB_PORT=5432

# Optional ssl mode for DB_* connections (example: require)
DB_SSLMODE=

# Security headers and cookies (recommended for HTTPS production)
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true

# SMTP / email
EMAIL_HOST=smtp.zeptomail.in
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=emailapikey
EMAIL_HOST_PASSWORD=replace-with-zeptomail-smtp-token
DEFAULT_FROM_EMAIL=LuxmorOne@luxmorai.com
# Optional: per-provider mailbox app passwords for Integration sync/send
# EMAIL_HOST_PASSWORD_PROVIDER_6=replace-with-app-password
# EMAIL_HOST_PASSWORD_MMUNI6467=replace-with-app-password
# EMAIL_PROVIDER_PASSWORDS=mmuni6467@gmail.com=pass1;vinishar2004@gmail.com=pass2

# Optional admin seed for post-deploy command
SEED_ADMIN_EMAIL=admin@crms.com
SEED_ADMIN_PASSWORD=Admin@Crms
SEED_ADMIN_NAME=Main Admin

# Optional integrations
X_HANDLE=
X_BEARER_TOKEN=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Logging
LOG_LEVEL=INFO
